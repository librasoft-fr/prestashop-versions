{#
  notification-bar.html.twig
  Injected on every BO page via the displayBackOfficeHeader hook.

  Variables expected (passed by UseHooks::hookDisplayBackOfficeHeader):
    - LIVE_MODE_VUEJS    (bool)   : true  → load from Vite dev server
                                    false → load from built asset
    - wc_js_url          (string) : URL to the built WC JS file
    - wc_css_url         (string) : URL to the built WC CSS file
    - current_version    (string) : current version of the module
    - module_manager_url (string) : URL to the module manager page in BO
#}
{% if LIVE_MODE_VUEJS %}
  <script type="module" src="http://localhost:5173/@vite/client"></script>
  <script type="module" src="http://localhost:5173/js/web-components/main.wc.js"></script>
{% else %}
  <link rel="stylesheet" href="{{ wc_css_url }}">
  <script type="module" src="{{ wc_js_url }}?v={{ current_version }}"></script>
{% endif %}

<mcp-notification-banner
  current-version="{{ current_version }}"
  module-manager-url="{{ module_manager_url }}"
></mcp-notification-banner>
