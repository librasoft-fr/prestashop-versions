{% extends '@PrestaShop/Admin/layout.html.twig' %}

{# ---------- CSS / Styles ---------- #}
{% block stylesheets %}
  {{ parent() }}

  {% if not LIVE_MODE_VUEJS %}
    {# Preload CSS #}
    {% if mcp_preload_urls is defined %}
      {% for p in mcp_preload_urls %}
        {% if p.rel == 'preload' and p.as == 'style' %}
          <link rel="preload" as="style" href="{{ p.href }}">
        {% endif %}
      {% endfor %}
    {% endif %}

    {# main CSS #}
    <link rel="stylesheet" href="{{ mcp_css_url }}" type="text/css" media="all">
  {% endif %}
{% endblock %}


{% block javascripts %}
  {{ parent() }}

  {% if LIVE_MODE_VUEJS %}
    <script type="module" src="http://localhost:5173/@vite/client"></script>
    <script type="module" src="http://localhost:5173/js/main.js"></script>
  {% else %}
    {# Preload chunks ESM (vendor + current language) #}
    {% if mcp_preload_urls is defined %}
      {% for p in mcp_preload_urls %}
        {% if p.rel == 'modulepreload' %}
          <link rel="modulepreload" href="{{ p.href }}">
        {% endif %}
      {% endfor %}
    {% endif %}

    {# main script from manifest #}
    <script type="module" src="{{ mcp_js_url }}"></script>
  {% endif %}

  <script src="{{ ps_account_cdn_url }}"></script>
{% endblock %}


{% block content %}
  <div id="vue-app"></div>
{% endblock %}
