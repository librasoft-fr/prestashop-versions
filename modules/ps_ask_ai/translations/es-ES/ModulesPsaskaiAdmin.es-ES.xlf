        <target>Actualización instalada</target>
        <note>Line: </note>
      </trans-unit>
      <trans-unit id="5b7ae750cd57d8ce894a3152aadbb4e3">
        <source>Refresh the page</source>
        <target>Actualizar la página</target>
        <note>Line: </note>
      </trans-unit>
      <trans-unit id="7589e3454a8891d234e4c2b9155ca35c">
        <source>The update failed.</source>
        <target>La actualización ha fallado.</target>
        <note>Line: </note>
      </trans-unit>
